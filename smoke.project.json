{
  "name": "VERITY Integrated Smoke",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      },
      "World": {
        "$path": "src/world"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Core": {
        "$className": "Folder",
        "BoostService": {
          "$path": "src/server/BoostService.luau"
        },
        "DataService": {
          "$path": "src/server/DataService.luau"
        },
        "DeliveryService": {
          "$path": "src/server/DeliveryService.luau"
        },
        "EconomyService": {
          "$path": "src/server/EconomyService.luau"
        },
        "IncomeService": {
          "$path": "src/server/IncomeService.luau"
        },
        "InteriorService": {
          "$path": "src/server/InteriorService.luau"
        },
        "PhoneService": {
          "$path": "src/server/PhoneService.luau"
        },
        "PlayerStateService": {
          "$path": "src/server/PlayerStateService.luau"
        },
        "PlotService": {
          "$path": "src/server/PlotService.luau"
        },
        "ProfileSchema": {
          "$path": "src/server/ProfileSchema.luau"
        },
        "RemoteService": {
          "$path": "src/server/RemoteService.luau"
        },
        "Runtime": {
          "$path": "src/server/Runtime.luau"
        },
        "ServerBootstrap": {
          "$path": "src/server/ServerBootstrap.server.luau"
        },
        "TaskService": {
          "$path": "src/server/TaskService.luau"
        },
        "UpgradeService": {
          "$path": "src/server/UpgradeService.luau"
        },
        "VerityService": {
          "$path": "src/server/VerityService.luau"
        },
        "WorldIntegration": {
          "$path": "src/server/WorldIntegration.luau"
        }
      },
      "CoreSmoke": {
        "$path": "scripts/studio_smoke.server.luau"
      },
      "CoreMultiplayerSmoke": {
        "$path": "scripts/studio_multiplayer.server.luau"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "InteriorTemplates": {
        "$className": "Folder",
        "StandardInterior": {
          "$path": "assets/interiors/StandardInterior.rbxmx"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "CoreSmoke": {
          "$path": "scripts/studio_smoke.client.luau"
        }
      }
    }
  }
}
