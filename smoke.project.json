      "CoreMultiplayerSmoke": { "$path": "scripts/studio_multiplayer.server.luau" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "CoreSmoke": { "$path": "scripts/studio_smoke.client.luau" }
      }
    }
  }
}
