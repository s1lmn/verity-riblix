,-1.3024300660846908},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap6",shape="Ball",pos={-0.21250000000000002,0.84375,-1.3120555187125778},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap7",shape="Ball",pos={-0.10624999999999996,0.8259375,-1.3174634311420308},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap8",shape="Ball",pos={0.0,0.82,-1.319205634895718},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap9",shape="Ball",pos={0.10624999999999996,0.8259375,-1.3174634311420308},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap10",shape="Ball",pos={0.21250000000000002,0.84375,-1.3120555187125778},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap11",shape="Ball",pos={0.31875,0.8734375,-1.3024300660846908},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap12",shape="Ball",pos={0.42499999999999993,0.9149999999999999,-1.2876383222804613},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap13",shape="Ball",pos={0.5312499999999999,0.9684374999999998,-1.2662809857251318},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap14",shape="Ball",pos={0.6375000000000001,1.03375,-1.236408698767975},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap15",shape="Ball",pos={0.74375,1.1109375,-1.195338562595269},size={0.075,0.075,0.075},color="10141A",glow=false},{name="SmileCap16",shape="Ball",pos={0.85,1.2,-1.1393034314119643},size={0.075,0.075,0.075},color="10141A",glow=false},{name="Dimple-0.85",shape="Ball",pos={-0.85,1.2,-1.1393034314119643},size={0.1,0.1,0.1},color="10141A"},{name="Dimple0.85",shape="Ball",pos={0.85,1.2,-1.1393034314119643},size={0.1,0.1,0.1},color="10141A"},{name="Aura0",shape="Ball",pos={1.55,0.12,0.0},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura1",shape="Ball",pos={1.4320132753924946,0.12,0.5931593201658891},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura2",shape="Ball",pos={1.0960155108391487,0.12,1.0960155108391485},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura3",shape="Ball",pos={0.5931593201658892,0.12,1.4320132753924946},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura4",shape="Ball",pos={9.491012693391987e-17,0.12,1.55},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura5",shape="Ball",pos={-0.5931593201658891,0.12,1.4320132753924946},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura6",shape="Ball",pos={-1.0960155108391485,0.12,1.0960155108391487},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura7",shape="Ball",pos={-1.4320132753924946,0.12,0.5931593201658893},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura8",shape="Ball",pos={-1.55,0.12,1.8982025386783975e-16},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura9",shape="Ball",pos={-1.4320132753924946,0.12,-0.593159320165889},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura10",shape="Ball",pos={-1.096015510839149,0.12,-1.0960155108391485},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura11",shape="Ball",pos={-0.59315932016589,0.12,-1.4320132753924941},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura12",shape="Ball",pos={-2.847303808017596e-16,0.12,-1.55},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura13",shape="Ball",pos={0.5931593201658896,0.12,-1.4320132753924943},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura14",shape="Ball",pos={1.0960155108391485,0.12,-1.096015510839149},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true},{name="Aura15",shape="Ball",pos={1.4320132753924941,0.12,-0.5931593201658901},size={0.105,0.105,0.105},color="FFE778",glow=true,optional=true}}}
