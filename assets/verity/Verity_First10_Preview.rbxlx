      <Item class="ModuleScript" referent="546">
        <Properties>
          <string name="Name">VerityVisualConfig</string>
          <string name="Source"><![CDATA[local Definitions = require(script.Parent.VerityDefinitions)
local LevelConfig = require(script.Parent.Parent.Shared.LevelConfig)
local Config = { MinLevel = 1, MaxAuthoredLevel = 10, Tag = "VerityPrototypeVisual" }
function Config.Get(level)
    assert(type(level) == "number" and level == level and level % 1 == 0 and level >= 1 and level <= 10,
        "Verity visuals are authored for integer levels 1..10 only")
    return Definitions[level]
end
function Config.GetScale(level)
    Config.Get(level)
    return LevelConfig.getVerityScale(level)
end
function Config.GetColor(level)
    return Color3.fromHex(Config.Get(level).Color)
end
return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="547">
        <Properties>
          <string name="Name">VerityMotion</string>
          <string name="Source"><![CDATA[-- Pure motion math, shared by renderer/tests. All translations are upward from the pad.
local Motion = {}
function Motion.Sample(definition, time)
    local phase = time * definition.Speed * 2
    local wave = (math.sin(phase)+1)/2
    local bob = definition.Bob * wave
    local yaw = math.sin(phase*.55)*.06
    local roll = math.sin(phase*.75)*.035
    if definition.Motion == "Hop" then bob = definition.Bob * math.max(0,math.sin(phase))^2 end
    if definition.Motion == "DoubleHop" then bob = definition.Bob * math.abs(math.sin(phase*1.5))^3 end
    if definition.Motion == "Tilt" then roll = math.sin(phase)*.12 end
    if definition.Motion == "Rock" then roll = math.sin(phase)*.07 end
    if definition.Motion == "Float" then yaw = math.sin(phase*.35)*.11 end
    if definition.Motion == "Sway" then roll = math.sin(phase)*.075 end
    if definition.Motion == "Orbit" then yaw = math.sin(phase*.4)*.1 end
    return bob, yaw, roll
end
function Motion.Transition(progress)
    local t=math.clamp(progress,0,1)
    local ease=1-(1-t)^3
    local pop=1+.14*math.sin(math.pi*t)*math.exp(-2*t)
    return ease,pop
end
return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="548">
        <Properties>
          <string name="Name">VerityPrototypeFactory</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.VerityVisualConfig)
local Recipes = require(script.Parent.VerityRecipe)
local Factory = {}

local function validIncome(value)
    return value == nil or (type(value) == "number" and value == value and value >= 0 and value < math.huge)
end
local function buildAppearance(level, anchor)
    local appearance = Instance.new("Model")
    appearance.Name = "Appearance"
    appearance:SetAttribute("VisualLevel", level)
    for _, data in Recipes[level] do
        local part = Instance.new("Part")
        part.Name = data.name
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = data.body == true
        part.Material = if data.glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
        part.Color = Color3.fromHex(data.color)
        part.Reflectance = if data.body then 0.045 else 0
        part.TopSurface = Enum.SurfaceType.Smooth
        part.BottomSurface = Enum.SurfaceType.Smooth
        if data.shape == "Rod" then
            local a = Vector3.new(data.a[1], data.a[2], data.a[3])
            local b = Vector3.new(data.b[1], data.b[2], data.b[3])
            part.Shape = Enum.PartType.Cylinder
            part.Size = Vector3.new((b-a).Magnitude, data.width, data.width)
            part.CFrame = CFrame.lookAt((a+b)/2, b) * CFrame.Angles(0, math.pi/2, 0)
        else
            part.Shape = Enum.PartType.Ball
            part.Size = Vector3.new(data.size[1], data.size[2], data.size[3])
            part.CFrame = CFrame.new(data.pos[1], data.pos[2], data.pos[3])
        end
        if data.optional then
            part:SetAttribute("OptionalEffect", true)
            part:SetAttribute("OrbitAngle",math.atan2(data.pos[3],data.pos[1]))
        end
        if data.eye then
            part:SetAttribute("BlinkEye",true)
            part:SetAttribute("EyeBaseSize",Vector3.new(data.size[1],data.size[2],data.size[3]))
        end
        part.Parent = appearance
        if data.body then appearance.PrimaryPart = part;part.PivotOffset = CFrame.new(0,-1.4,0) end
    end
    if Config.Get(level).Special then
        local glow = Instance.new("PointLight")
        glow.Name = "AccentGlow";glow.Color = Color3.fromRGB(126,245,255)
        glow.Brightness = 0.35;glow.Range = 7;glow.Shadows = false
        glow.Parent = appearance.PrimaryPart
    end
    appearance:ScaleTo(Config.GetScale(level))
    appearance:PivotTo(anchor)
    return appearance
end
local function label(model, level, income)
    local gui = model.Root:FindFirstChild("Label")
    if not gui then
        gui = Instance.new("BillboardGui");gui.Name = "Label";gui.Size = UDim2.fromOffset(240,64)
        gui.AlwaysOnTop = false;gui.MaxDistance = 110;gui.Parent = model.Root
        local text = Instance.new("TextLabel");text.Name = "Text";text.Size = UDim2.fromScale(1,1)
        text.BackgroundTransparency = 1;text.Font = Enum.Font.GothamBold;text.TextSize = 18
        text.TextColor3 = Color3.fromRGB(255,255,255);text.TextStrokeColor3 = Color3.fromRGB(28,34,65)
        text.TextStrokeTransparency = 0.2;text.Parent = gui
    end
    gui.StudsOffsetWorldSpace = Vector3.new(0,3.25*Config.GetScale(level),0)
    local suffix = if income ~= nil then string.format("\n$%.0f/sec",income) else ""
    gui.Text.Text = string.format("VERITY • LEVEL %d%s",level,suffix)
end

function Factory.SetState(model, level, incomePerSecond)
    assert(not RunService:IsClient(), "Core must apply confirmed visual state on the server")
    Config.Get(level)
    assert(validIncome(incomePerSecond), "Income must be finite and nonnegative, or nil")
    assert(model:IsA("Model") and model:FindFirstChild("Root"), "Expected a Verity model")
    local appearance = buildAppearance(level, model.Root.CFrame)
    local old = model:FindFirstChild("Appearance")
    if old then old:Destroy() end
    appearance.Parent = model
    model:SetAttribute("IncomePerSecond", incomePerSecond)
    label(model,level,incomePerSecond)
    model:SetAttribute("VisualLevel", level)
    CollectionService:AddTag(model,Config.Tag)
end
function Factory.Create(parent, options)
    assert(typeof(parent) == "Instance", "Verity needs a parent")
    options = options or {}
    local level = options.Level or 1;Config.Get(level)
    assert(validIncome(options.IncomePerSecond), "Invalid income")
    local anchor = options.Anchor or CFrame.identity
    assert(typeof(anchor) == "CFrame", "Anchor must be a CFrame at the floor")
    local model = Instance.new("Model");model.Name = "Verity";model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    local root = Instance.new("Part");root.Name = "Root";root.Size = Vector3.new(.1,.1,.1)
    root.Anchored = true;root.Transparency = 1;root.CanCollide = false;root.CanTouch = false;root.CanQuery = false
    root.CFrame = anchor;root.Parent = model;model.PrimaryPart = root
    if options.OwnerUserId then model:SetAttribute("OwnerUserId", options.OwnerUserId) end
    Factory.SetState(model,level,options.IncomePerSecond)
    model.Parent = parent
    return model
end
function Factory.Pulse(model)
    assert(not RunService:IsClient(), "Only server-authorised visual actions")
    model:SetAttribute("VisualPulse",(model:GetAttribute("VisualPulse") or 0)+1)
end
return Factory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="549">
        <Properties>
          <string name="Name">VerityVisualService</string>
          <string name="Source"><![CDATA[-- Client-only presentation. Never changes money, level, owner or server Root position.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Config = require(script.Parent.VerityVisualConfig)
local Motion = require(script.Parent.VerityMotion)
local Service = {}
local records, connections = {}, {}
local options = { ReducedMotion=false, ReducedEffects=false, AnimateDistance=180 }
local effects, started, accumulator

local function burst(record, level)
    if options.ReducedEffects or options.ReducedMotion or not effects then return end
    local special=Config.Get(level).Special
    local folder=Instance.new("Folder");folder.Name="UpgradeBurst";folder.Parent=effects
    local size=Config.GetScale(level);local count=if special then 12 else 5
    for i=1,count do
        local p=Instance.new("Part");p.Shape=Enum.PartType.Ball;p.Anchored=true
        p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
        p.Material=if special then Enum.Material.Neon else Enum.Material.SmoothPlastic
        p.Color=if special then Color3.fromRGB(143,251,255) else Config.GetColor(level)
        p.Size=Vector3.one*.13*size
        p.Position=record.model.Root.Position+Vector3.new(0,1.4*size,0);p.Parent=folder
        local a=i*math.pi*2/count
        local destination=p.Position+Vector3.new(math.cos(a)*1.8, .4+(i%3)*.4, math.sin(a)*1.8)*size
        TweenService:Create(p,TweenInfo.new(.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
            {Position=destination,Transparency=1,Size=Vector3.one*.025*size}):Play()
    end
    Debris:AddItem(folder,.65)
end
local function observe(model)
    if not model:IsA("Model") or records[model] then return end
    records[model]={model=model,level=nil,scale=nil,color=nil,pulse=model:GetAttribute("VisualPulse"),elapsed=1,appearance=nil}
end
local function forget(model) records[model]=nil end
local function resetPose(record)
    local model=record.model;local a=model:FindFirstChild("Appearance");local root=model:FindFirstChild("Root")
    local level=model:GetAttribute("VisualLevel")
    if a and a:IsA("Model") and root and type(level)=="number" and level%1==0 and level>=1 and level<=10 then
        a:ScaleTo(Config.GetScale(level));a:PivotTo(root.CFrame)
        local body=a:FindFirstChild("Body");if body then body.Color=Config.GetColor(level) end
        for _,p in a:GetChildren() do
            if p:IsA("BasePart") and p:GetAttribute("OptionalEffect") then p.Transparency=0 end
            if p:IsA("BasePart") and p:GetAttribute("BlinkEye") then p.Size=p:GetAttribute("EyeBaseSize")*Config.GetScale(level) end
        end
        local glow=body and body:FindFirstChild("AccentGlow");if glow then glow.Enabled=true end
    end
end
local function step(dt)
    accumulator+=dt
    if accumulator<1/30 then return end
    local delta=math.min(accumulator,.2);accumulator=0
    local now=os.clock();local camera=workspace.CurrentCamera
    for model,record in records do
        local root=model:FindFirstChild("Root");local a=model:FindFirstChild("Appearance")
        local level=model:GetAttribute("VisualLevel")
        if not model:IsDescendantOf(workspace) then forget(model);continue end
        if not root or not a or not a:IsA("Model") or not a.PrimaryPart then continue end
        if type(level)~="number" or level%1~=0 or level<1 or level>10 or a:GetAttribute("VisualLevel")~=level then continue end
        local definition=Config.Get(level);local target=Config.GetScale(level)
        local nonce=model:GetAttribute("VisualPulse")
        if record.level~=level or record.pulse~=nonce then
            local first=record.level==nil
            record.fromScale=record.scale or target;record.fromColor=record.color or Config.GetColor(level)
            record.elapsed=if first then 1 else 0
            record.level=level;record.pulse=nonce
            if not first and (not camera or (camera.CFrame.Position-root.Position).Magnitude<options.AnimateDistance) then burst(record,level) end
        end
        if a~=record.appearance then
            record.appearance=a;record.appliedScale=nil;record.optional={};record.eyes={};record.glow=a.PrimaryPart:FindFirstChild("AccentGlow")
            for _,p in a:GetChildren() do
                if p:IsA("BasePart") and p:GetAttribute("OptionalEffect") then table.insert(record.optional,p) end
                if p:IsA("BasePart") and p:GetAttribute("BlinkEye") then table.insert(record.eyes,p) end
            end
        end
        record.elapsed+=delta
        local progress=record.elapsed/.75;local ease,pop=Motion.Transition(progress)
        record.scale=record.fromScale+(target-record.fromScale)*ease
        record.color=record.fromColor:Lerp(Config.GetColor(level),ease)
        local distant=camera and (camera.CFrame.Position-root.Position).Magnitude>options.AnimateDistance
        local reduced=options.ReducedMotion or distant
        local bob,yaw,roll=0,0,0
        if not reduced then bob,yaw,roll=Motion.Sample(definition,now+root.Position.X*.03) end
        local applied=if reduced then target else record.scale*pop
        if not record.appliedScale or math.abs(record.appliedScale-applied)>.001 then
            a:ScaleTo(applied);record.appliedScale=applied
        end
        if not reduced and progress<1 and definition.Motion=="Spin" then yaw+=math.pi*2*ease end
        local lift=if reduced then 0 else (.04+bob+1.4*(1-math.cos(roll)))*applied
        a:PivotTo(root.CFrame*CFrame.new(0,lift,0)*CFrame.Angles(0,yaw,roll))
        a.PrimaryPart.Color=if reduced then Config.GetColor(level) else record.color
        for _,p in record.optional do
            p.Transparency=if options.ReducedEffects then 1 else 0
            local angle=(p:GetAttribute("OrbitAngle") or 0)+(if reduced then 0 else now*.65)
            p.CFrame=root.CFrame*CFrame.new(0,lift,0)*CFrame.new(math.cos(angle)*1.55*applied,.12*applied,math.sin(angle)*1.55*applied)
        end
        local blinkPhase=(now+root.Position.X*.17)%4.5
        local blink=if not reduced and blinkPhase<.18 then 1-.93*math.sin(math.pi*blinkPhase/.18) else 1
        for _,p in record.eyes do
            local base=p:GetAttribute("EyeBaseSize")
            if typeof(base)=="Vector3" then p.Size=Vector3.new(base.X,base.Y*blink,base.Z)*applied end
        end
        if record.glow then record.glow.Enabled=not options.ReducedEffects and not distant end
    end
end
function Service.SetOptions(values)
    if values.ReducedMotion~=nil then options.ReducedMotion=values.ReducedMotion==true end
    if values.ReducedEffects~=nil then options.ReducedEffects=values.ReducedEffects==true end
    if type(values.AnimateDistance)=="number" and values.AnimateDistance>0 and values.AnimateDistance<math.huge then options.AnimateDistance=values.AnimateDistance end
end
function Service.Start()
    assert(RunService:IsClient(),"VerityVisualService is client-only")
    if started then return end
    started=true;accumulator=0
    effects=Instance.new("Folder");effects.Name="VerityClientEffects";effects.Parent=workspace
    for _,model in CollectionService:GetTagged(Config.Tag) do observe(model) end
    table.insert(connections,CollectionService:GetInstanceAddedSignal(Config.Tag):Connect(observe))
    table.insert(connections,CollectionService:GetInstanceRemovedSignal(Config.Tag):Connect(forget))
    table.insert(connections,RunService.RenderStepped:Connect(step))
end
function Service.Stop()
    for _,c in connections do c:Disconnect() end;table.clear(connections)
    for _,record in records do resetPose(record) end;table.clear(records)
    if effects then effects:Destroy();effects=nil end
    started=false
end
return Service
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="550">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="551">
        <Properties>
          <string name="Name">LevelConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Shared exact growth contract. Core owns economy; this module has no prices.
local LevelConfig = { MinLevel = 1, MaxLevel = 100 }
LevelConfig.Milestones = table.freeze({
	{ level = 10, name = "STARLIGHT", reward = "New idle + star trail" },
	{ level = 25, name = "LEVITATION", reward = "Floating idle + glowing aura" },
	{ level = 50, name = "POWER PULSE", reward = "Power impulse + light wave" },
	{ level = 75, name = "LEGENDARY", reward = "Legendary spin + energy rings" },
	{ level = 100, name = "FINAL EVOLUTION", reward = "Giant 15× form + crown + layered aura" },
})

function LevelConfig.getVerityScale(level: number): number
	assert(type(level) == "number" and level == level and level % 1 == 0 and level >= 1 and level <= 100,
		"Verity level must be an integer from 1 to 100")
	return 1 + 14 * ((level - 1) / 99) ^ 0.85
end

return table.freeze(LevelConfig)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="552">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="553">
      <Properties>
        <string name="Name">GalleryBootstrap</string>
        <string name="Source"><![CDATA[-- Isolated art review only. Do not enable this script in the production map.
local World=game:GetService("ReplicatedStorage"):WaitForChild("World")
local Factory=require(World.VerityPrototypeFactory)
local Config=require(World.VerityVisualConfig)
local old=workspace:FindFirstChild("VerityGallery")
if old then old:Destroy() end
local gallery=Instance.new("Folder");gallery.Name="VerityGallery";gallery.Parent=workspace
local function part(name,pos,size,color)
    local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.Size=size;p.Position=pos
    p.Material=Enum.Material.SmoothPlastic;p.Color=color;p.Parent=gallery;return p
end
part("Floor",Vector3.new(-6,-.5,8),Vector3.new(112,1,80),Color3.fromRGB(44,53,84))
local spawn=Instance.new("SpawnLocation");spawn.Name="GallerySpawn";spawn.Anchored=true
spawn.Size=Vector3.new(6,1,6);spawn.CFrame=CFrame.new(0,.5,-24)*CFrame.Angles(0,math.pi,0)
spawn.Transparency=1;spawn.CanCollide=false;spawn.Neutral=true;spawn.Duration=0;spawn.Parent=gallery
local function prompt(parent,text,callback)
    local p=Instance.new("ProximityPrompt");p.ActionText=text;p.ObjectText="VERITY VISUAL REVIEW"
    p.MaxActivationDistance=12;p.RequiresLineOfSight=false;p.HoldDuration=0;p.Parent=parent
    local last=0
    p.Triggered:Connect(function() if os.clock()-last>.4 then last=os.clock();callback() end end)
end
for level=1,10 do
    local x=((level-1)%5-2)*16;local z=math.floor((level-1)/5)*24
    local pad=part("Pad"..level,Vector3.new(x,.25,z),Vector3.new(11,.5,11),Config.GetColor(level))
    local model=Factory.Create(gallery,{Level=level,Anchor=CFrame.new(x,.5,z)})
    model.Name=string.format("Verity_%02d",level)
    prompt(pad,"Показать апгрейд",function() Factory.Pulse(model) end)
end
local testPad=part("UpgradeReviewPad",Vector3.new(-50,.25,10),Vector3.new(11,.5,11),Color3.fromRGB(255,224,55))
local test=Factory.Create(gallery,{Level=1,Anchor=CFrame.new(-50,.5,10)});test.Name="UpgradeReview"
local current=1
prompt(testPad,"Следующий уровень 1–10",function()
    current=current%10+1
    Factory.SetState(test,current,nil)
end)
for i,spec in {{"ReducedMotion",Vector3.new(-16,1,-20),"VerityReducedMotion"},{"ReducedEffects",Vector3.new(16,1,-20),"VerityReducedEffects"}} do
    local p=part(spec[1],spec[2],Vector3.new(6,2,3),Color3.fromRGB(125,91,255))
    prompt(p,"Переключить "..spec[1],function() workspace:SetAttribute(spec[3],workspace:GetAttribute(spec[3])~=true) end)
end
local Lighting=game:GetService("Lighting")
Lighting.ClockTime=13.5;Lighting.Brightness=2
Lighting.Ambient=Color3.fromRGB(150,155,174);Lighting.OutdoorAmbient=Color3.fromRGB(160,170,188)
local bloom=Lighting:FindFirstChild("VerityReviewBloom")
if not bloom then bloom=Instance.new("BloomEffect");bloom.Name="VerityReviewBloom";bloom.Parent=Lighting end
bloom.Intensity=.16;bloom.Threshold=1.2;bloom.Size=16
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="554">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="555">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="556">
        <Properties>
          <string name="Name">VerityVisualBootstrap</string>
          <string name="Source"><![CDATA[-- Separate World presentation bootstrap; does not modify the UI team's files.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local world=ReplicatedStorage:WaitForChild("World",15)
if not world then warn("Verity World modules unavailable");return end
local Service=require(world:WaitForChild("VerityVisualService",15))
local playerGui=Players.LocalPlayer:WaitForChild("PlayerGui",15)
if not playerGui then return end
local guiConnections={}
local connections={}
local function bindSettings()
    for _,c in guiConnections do c:Disconnect() end;table.clear(guiConnections)
    local gui=playerGui:FindFirstChild("VerityUI")
    local function refresh()
        Service.SetOptions({
            ReducedMotion=(gui and gui:GetAttribute("ReducedMotion")==true) or workspace:GetAttribute("VerityReducedMotion")==true,
            ReducedEffects=(gui and gui:GetAttribute("ReducedEffects")==true) or workspace:GetAttribute("VerityReducedEffects")==true,
        })
    end
    if gui then
        table.insert(guiConnections,gui:GetAttributeChangedSignal("ReducedMotion"):Connect(refresh))
        table.insert(guiConnections,gui:GetAttributeChangedSignal("ReducedEffects"):Connect(refresh))
    end
    refresh()
end
table.insert(connections,playerGui.ChildAdded:Connect(function(x) if x.Name=="VerityUI" then bindSettings() end end))
table.insert(connections,playerGui.ChildRemoved:Connect(function(x) if x.Name=="VerityUI" then bindSettings() end end))
table.insert(connections,workspace:GetAttributeChangedSignal("VerityReducedMotion"):Connect(bindSettings))
table.insert(connections,workspace:GetAttributeChangedSignal("VerityReducedEffects"):Connect(bindSettings))
bindSettings();Service.Start()
script.Destroying:Connect(function()
    for _,c in connections do c:Disconnect() end
    for _,c in guiConnections do c:Disconnect() end
    Service.Stop()
end)
]]></string>
        </Properties>
      </Item>
    </Item>
