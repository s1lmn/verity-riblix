return function(load,check)
	local p=load("src/client/CoreProtocol")
	local f=load("tests/Fixture")(load)
	local profile=f.join(1)
	local raw=f.State:Snapshot(1)
	local state=p.State(raw)
	check(state.version==1 and state.PhoneSessionOpen==false)
	local valid,reason=load("src/client/UIModel").ValidateSnapshot(state)
	check(valid~=nil,reason)
	check(#valid.Tasks==3 and valid.Tasks[1].reward>0)
	local result=p.Result({protocolVersion=1,action="RequestUpgradeVerity",operationId="2",status="OK",reward=0,stateRevision=3})
	check(result.action=="UpgradeVerity" and result.success and result.operationId=="2")
	check(p.Result({protocolVersion=1,action="RequestSwipe",status="PHONE_CLOSED"}).errorCode=="PHONE_SESSION_CLOSED")
	check(p.World({protocolVersion=1,type="VerityLevelChanged"}).kind=="VerityLevelChanged")
	check(p.State(false)==nil and p.Result(nil)==nil)
end
