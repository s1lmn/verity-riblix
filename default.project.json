{
  "name": "VerityNeighborhood",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "World": {
        "$path": "src/world"
      },
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "MapBootstrap": {
        "$path": "src/server/MapBootstrap.server.luau"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "VerityClient": {
          "$path": "src/client"
        },
        "VerityWorldVisuals": {
          "$path": "src/world-client"
        }
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    }
  }
}
