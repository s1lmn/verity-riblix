{
  "name": "VerityNeighborhood",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "World": {
        "$path": "src/world"
      }
    },
    "ServerScriptService": {
      "MapBootstrap": {
        "$path": "src/server/MapBootstrap.server.luau"
      }
    },
    "ServerStorage": {
      "InteriorTemplates": {
        "$className": "Folder",
        "StandardInterior": {
          "$path": "assets/interiors/StandardInterior.rbxmx"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    }
  }
}
