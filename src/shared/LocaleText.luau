function Text.Get(language, source)
	return (if language == "en" then en else ru)[source] or source
end

function Text.Has(source)
	return ru[source] ~= nil or en[source] ~= nil
end

function Text.SetWorld(instance, property, source, ...)
	local translatedRu = Text.Get("ru", source)
	local translatedEn = Text.Get("en", source)
	if select("#", ...) > 0 then
		translatedRu = string.format(translatedRu, ...)
		translatedEn = string.format(translatedEn, ...)
	end
	instance[property] = translatedRu
	instance:SetAttribute(property .. "_locale_ru", translatedRu)
	instance:SetAttribute(property .. "_locale_en", translatedEn)
	instance:AddTag(Text.WorldTag)
end

return Text
